# .env.local.example
# Copy this file to .env.local and adjust values for your local setup.
# .env.local is gitignored — never commit it.
#
# VITE_API_URL: URL the Vite dev server proxies /api/* requests to.
# Change this only if your API is not running on the default port.
# Default (if omitted): http://localhost:5115
#
VITE_API_URL=http://localhost:5115
